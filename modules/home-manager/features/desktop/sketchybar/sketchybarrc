#!/usr/bin/env bash
# SketchyBar: on trial, driven by wanting AeroSpace workspaces in the bar.
#
# Additive on purpose — the macOS menu bar stays visible and SwiftBar keeps
# running, so this can be compared side by side and dropped in one line
# (features.desktop.sketchybar.enable) without leaving a gap.
#
# Scripts run detached from a login shell, so PATH is set explicitly. Six
# separate times this session a nix-profile tool has shadowed the BSD one.
export PATH="/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:/usr/local/bin:/sbin:/usr/sbin:/usr/bin:/bin"

# Tokyo Night, matching the VS Code theme.
BG=0xf01a1b26
FG=0xffc0caf5
DIM=0xff565f89
ACCENT=0xff7aa2f7
GREEN=0xff9ece6a
SURFACE=0xff24283b

FONT="SF Pro"
APP_FONT="sketchybar-app-font"

# notch_width keeps items clear of the camera housing. Nothing is placed in the
# centre either: on a notched display that is the one position guaranteed to be
# cut in half, which is what the gap in the middle of the bar was.
sketchybar --bar height=34 \
                 position=top \
                 sticky=on \
                 padding_left=10 \
                 padding_right=10 \
                 color=$BG \
                 blur_radius=30 \
                 notch_width=200 \
                 shadow=off

sketchybar --default icon.font="$FONT:Bold:13.0" \
                     icon.color=$FG \
                     label.font="$FONT:Semibold:13.0" \
                     label.color=$FG \
                     padding_left=3 \
                     padding_right=3 \
                     background.corner_radius=7 \
                     background.height=24

# ---- AeroSpace workspaces --------------------------------------------------
# The custom event must exist before anything subscribes, or every subscribe
# fails with "Event not found" and the workspaces never redraw.
sketchybar --add event aerospace_workspace_change

for wid in $(aerospace list-workspaces --all 2>/dev/null); do
  sketchybar --add item "space.$wid" left \
             --subscribe "space.$wid" aerospace_workspace_change front_app_switched \
             --set "space.$wid" \
                   label="$wid" \
                   label.color=$DIM \
                   label.padding_left=9 \
                   label.padding_right=9 \
                   background.color=$ACCENT \
                   background.drawing=off \
                   update_freq=5 \
                   click_script="aerospace workspace $wid" \
                   script="$CONFIG_DIR/plugins/workspace.sh $wid"
done

# ---- focused app, with its own icon ----------------------------------------
sketchybar --add item front_app left \
           --subscribe front_app front_app_switched \
           --set front_app icon.font="$APP_FONT:Regular:15.0" \
                           icon.color=$ACCENT \
                           label.color=$FG \
                           padding_left=14 \
                           background.color=$SURFACE \
                           background.drawing=on \
                           label.padding_right=10 \
                           icon.padding_left=10 \
                           script="$CONFIG_DIR/plugins/front_app.sh"

sketchybar --add item music left \
           --set music update_freq=10 \
                       icon.color=$GREEN \
                       icon.padding_left=14 \
                       icon.padding_right=6 \
                       label.color=$DIM \
                       label.max_chars=38 \
                       scroll_texts=on \
                       click_script="osascript -e 'tell application \"Spotify\" to playpause'" \
                       script="$CONFIG_DIR/plugins/music.sh"

# ---- right side, grouped in one rounded surface ----------------------------
sketchybar --add item clock right \
           --set clock icon="􀐫" icon.color=$DIM update_freq=10 \
                       script="$CONFIG_DIR/plugins/clock.sh"

sketchybar --add item battery right \
           --subscribe battery power_source_change system_woke \
           --set battery update_freq=120 script="$CONFIG_DIR/plugins/battery.sh"

# Reads the SwiftBar collector's cache rather than re-querying restic: two
# things polling the same repository on different schedules is how lock
# contention starts, which cost five days of backups this week.
sketchybar --add item backup right \
           --set backup icon="􀈄" icon.color=$DIM update_freq=300 \
                        script="$CONFIG_DIR/plugins/backup.sh"

sketchybar --add item vitals right \
           --set vitals icon="􀫥" icon.color=$DIM update_freq=15 \
                        icon.padding_right=6 \
                        script="$CONFIG_DIR/plugins/vitals.sh"

# Wi-Fi and tailnet together: all DNS on this machine goes through the tailnet,
# so "wifi is up" on its own is not the question worth answering.
sketchybar --add item network right \
           --subscribe network wifi_change system_woke \
           --set network update_freq=30 \
                         icon.padding_right=6 \
                         script="$CONFIG_DIR/plugins/network.sh"

sketchybar --add item keyboard right \
           --set keyboard icon="􀇳" icon.color=$DIM update_freq=5 \
                          icon.padding_right=6 \
                          script="$CONFIG_DIR/plugins/keyboard.sh"

sketchybar --add bracket status vitals network keyboard backup battery clock \
           --set status background.color=$SURFACE \
                        background.corner_radius=8 \
                        background.height=26

sketchybar --update
